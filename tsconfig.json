{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/core.test.ts",
    "tests/transport.test.ts",
    "tests/scripts.test.ts",
    "tests/writing.test.ts",
    "tests/shortcuts.test.ts",
    "tests/workspace.test.ts",
    "tests/timeline.test.ts",
    "tests/timeline-librarian.test.ts",
    "tests/librarian-review.test.ts"
  ]
}
